{
	"schemaVersion": 1,
	"id": "vulkanfixes",
	"version": "${version}",
	"name": "VulkanFixes",
	"description": "Fixes the frame drops VulkanMod shows when turning toward a sunrise or sunset in fullscreen, without changing how the game looks.",
	"authors": [
		"relapzz"
	],
	"contact": {
		"homepage": "https://github.com/Relapzzz/VulkanFixes",
		"sources": "https://github.com/Relapzzz/VulkanFixes",
		"issues": "https://github.com/Relapzzz/VulkanFixes/issues"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": ${entrypoints},
	"mixins": [
		"vulkanfixes.mixins.json"
	],
	"accessWidener": "vulkanfixes.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "${minecraft_range}",
		"java": ">=21",
		"vulkanmod": "*"
	}
}
